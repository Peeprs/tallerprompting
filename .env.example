# Frontend — telemetría (Vite solo expone variables VITE_*; nunca guardar secretos aquí)
VITE_ENVIRONMENT=local
VITE_APP_VERSION=1.0.0
# 1.0 = 100 % en desarrollo; bajar en producción (p. ej. 0.1).
VITE_TRACING_SAMPLE_RATE=1.0
# true en desarrollo; false en producción salvo diagnóstico controlado.
VITE_TELEMETRY_CONSOLE=true
# Opcional: colector OTLP/HTTP JSON (sin credenciales en el cliente).
# VITE_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
